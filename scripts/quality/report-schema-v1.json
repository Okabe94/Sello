{
  "$comment": "Sello quality report, schema version 1. Written by scripts/quality/runner.py, enforced by scripts/quality/evidence.py, which supports exactly the keywords used here: type, required, properties, items, enum, const, minimum, pattern.",
  "type": "object",
  "required": ["schema_version", "run_id", "ticket", "gate", "outcome", "failures", "warnings", "snapshot", "environment", "devices", "checks", "started_at", "finished_at"],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "pattern": "^[0-9]{8}T[0-9]{6}Z-[0-9a-f]{8}$"},
    "ticket": {"type": "string", "pattern": "^(SELLO-[0-9]{3}|UNTICKETED)$"},
    "gate": {
      "type": "object",
      "required": ["required", "executed"],
      "properties": {
        "required": {"enum": ["G1", "G2", "G3"]},
        "executed": {"enum": ["G1", "G2", "G3"]}
      }
    },
    "outcome": {"enum": ["passed", "failed"]},
    "failures": {"type": "array", "items": {"type": "string"}},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "snapshot": {
      "type": "object",
      "required": ["head", "dirty", "dirty_files", "fingerprint", "acceptance"],
      "properties": {
        "head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "dirty": {"type": "boolean"},
        "dirty_files": {"type": "array", "items": {"type": "string"}},
        "fingerprint": {
          "type": "object",
          "required": ["algorithm", "value", "files"],
          "properties": {
            "algorithm": {"const": "sha256"},
            "value": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "files": {"type": "integer", "minimum": 1}
          }
        },
        "acceptance": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "environment": {"type": "object"},
    "devices": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["serial", "api", "model"],
        "properties": {
          "serial": {"type": "string"},
          "api": {"type": "string"},
          "model": {"type": "string"}
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "command", "log", "exit_code", "started_at", "finished_at"],
        "properties": {
          "name": {"type": "string"},
          "command": {"type": "string"},
          "log": {"type": "string"},
          "exit_code": {"type": "integer"},
          "started_at": {"type": "string"},
          "finished_at": {"type": "string"},
          "results": {"type": "object"},
          "lint": {"type": "object"}
        }
      }
    },
    "started_at": {"type": "string"},
    "finished_at": {"type": "string"}
  }
}
